{
    "$schema": "https://aka.ms/winget-settings.schema.json",
    "visual": {
        "progressBar": "accent"
    },
    "installBehavior": {
        "defaultInstallRoot": "D:/Program/",
        "portablePackageUserRoot": "D:/Program/",
        "portablePackageMachineRoot": "D:/Program/",
        "preferences": {
            "scope": "user",
            "architectures": [
                "x64"
            ],
            "installerTypes": [
                "exe",
                "msi",
                "msix",
                "portable",
                "zip"
            ],
            "locale": [
                "en-US"
            ]
        }
    },
    "uninstallBehavior": {
        "purgePortablePackage": true
    },
    "telemetry": {
        "disable": true
    }
}
